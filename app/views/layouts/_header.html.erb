<header class="border-b border-border bg-surface">
  <div class="mx-auto flex max-w-[1040px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-2">
    <%= link_to articles_path, class: "inline-flex min-h-11 items-center gap-2.5 font-serif text-2xl font-semibold text-ink" do %>
      <svg aria-hidden="true" class="size-8 text-accent" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8l4 3h12l4-3v10a10 10 0 0 1-20 0z"/><circle cx="12" cy="17" r="2.5"/><circle cx="20" cy="17" r="2.5"/><path d="M16 20l-1.5 2.5h3z"/></svg>
      Strix
    <% end %>
    <nav aria-label="Main" class="flex flex-wrap gap-1">
      <% ApplicationHelper::NAV_ITEMS.each do |section, label| %>
        <%= nav_link(section, label) %>
      <% end %>
    </nav>
  </div>
</header>
