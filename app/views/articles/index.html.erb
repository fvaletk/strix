<% content_for :wide, true %>
<div class="flex items-baseline gap-3">
  <h1 class="font-serif text-4xl font-semibold">Articles</h1>
  <span class="text-ink-3"><%= pluralize(@articles.size, "Article") %></span>
</div>

<section class="mt-6 rounded-2xl border border-border bg-surface p-5">
  <%= form_with model: @article, url: articles_path do |form| %>
    <% if @article.errors.any? %>
      <ul role="alert" class="mb-3 rounded-[10px] bg-warn-soft px-4 py-3 text-warn-ink">
        <% @article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
    <%= form.label :url, "Save an Article", class: "mb-2 block font-semibold" %>
    <div class="flex flex-col gap-3 sm:flex-row">
      <%= form.text_field :url, placeholder: "https://", aria: { describedby: "url-help" },
            class: "h-12 min-w-0 flex-1 rounded-[10px] border border-control bg-field px-4 text-ink placeholder:text-ink-3" %>
      <%= form.submit "Save", class: "#{button_classes(:primary)} cursor-pointer" %>
    </div>
    <p id="url-help" class="mt-2 text-sm text-ink-3">Paste a link. Strix reads it, summarises it and tags it.</p>
  <% end %>
</section>

<div class="mt-6 flex flex-col gap-4">
  <% @articles.each do |article| %>
    <%= render ArticleRowComponent.new(article: article) %>
  <% end %>
</div>
