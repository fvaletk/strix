<h1><%= ArticlePresenter.new(@article).display_title %></h1>
<dl>
  <dt>URL</dt><dd><%= @article.url %></dd>
  <dt>Title</dt><dd><%= @article.title %></dd>
  <dt>Status</dt><dd><%= @article.status %></dd>
</dl>
<% if @article.summary_tldr.present? %>
  <section>
    <h2>TL;DR</h2>
    <p><%= @article.summary_tldr %></p>
    <h2>Key points</h2>
    <ol>
      <% @article.summary_key_points.each do |point| %>
        <li><%= point %></li>
      <% end %>
    </ol>
  </section>
<% end %>
<%= link_to "Back to Articles", articles_path %>
