<h1>Ask a Question</h1>

<%= form_with model: @question, url: questions_path do |form| %>
  <% if @question.errors.any? %>
    <ul role="alert">
      <% @question.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form.label :text, "Question" %>
  <%= form.text_area :text %>
  <%= form.submit "Ask" %>
<% end %>

<%= link_to "Past Questions", questions_path %>
