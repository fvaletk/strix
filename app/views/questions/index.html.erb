<% content_for :wide, true %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-baseline gap-3">
    <h1 class="font-serif text-4xl font-semibold">Questions</h1>
    <span class="text-ink-3"><%= pluralize(@questions.size, "Question") %></span>
  </div>
  <%= link_to "Ask a Question", new_question_path, class: button_classes(:primary) %>
</div>

<div class="mt-6 flex flex-col gap-4">
  <% @questions.each do |question| %>
    <%= render QuestionRowComponent.new(question: question) %>
  <% end %>
</div>
