<% question = QuestionPresenter.new(@question) %>
<% answer = @question.answer && AnswerPresenter.new(@question.answer) %>
<%= link_to "← Questions", questions_path, class: "inline-flex min-h-11 items-center text-accent hover:underline" %>

<p class="mt-2 text-xs font-semibold uppercase tracking-wider text-ink-3">Question</p>
<h1 class="font-serif text-4xl leading-tight font-semibold"><%= question.text %></h1>
<p class="mt-2 text-sm text-ink-3">Asked <%= question.asked_on %> · searched all Articles</p>

<% if answer.nil? %>
  <div class="mt-6">
    <%= render NoticeComponent.new(variant: :failure) do %>
      <% if flash[:alert].present? %><p role="alert" class="font-semibold"><%= flash[:alert] %></p><% end %>
      <p>No answer yet.</p>
    <% end %>
  </div>
  <div class="mt-8"><%= link_to "Ask another Question", new_question_path, class: button_classes(:primary) %></div>
<% elsif answer.nothing_found? %>
  <section class="mt-6 rounded-2xl border border-border bg-surface p-6">
    <%= render EmptyStateComponent.new(title: answer.text, helper: "Try saving an Article on this topic, or ask in different words.") do %>
      <%= link_to "Save an Article", articles_path, class: button_classes(:primary) %>
      <%= link_to "Ask something else", new_question_path, class: button_classes(:secondary) %>
    <% end %>
  </section>
<% else %>
  <section class="mt-6 rounded-2xl border border-border bg-surface p-6" data-answer-text="<%= answer.text %>">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-3">Answer</h2>
    <% answer.paragraphs.each do |segments| %>
      <p class="mt-3 font-serif text-xl leading-relaxed text-reading">
        <% segments.each do |segment| %><% if segment.is_a?(Integer) %><%= render CitationMarkerComponent.new(number: segment) %><% else %><%= segment %><% end %><% end %>
      </p>
    <% end %>
  </section>
  <% if answer.sources.any? %>
    <section class="mt-8">
      <h2 class="font-serif text-2xl font-semibold">Cited Articles</h2>
      <div class="mt-3 flex flex-col gap-3">
        <% answer.sources.each do |article, number| %>
          <%= render SourceCardComponent.new(article: article, number: number) %>
        <% end %>
      </div>
    </section>
  <% end %>
  <div class="mt-8"><%= link_to "Ask another Question", new_question_path, class: button_classes(:primary) %></div>
<% end %>
