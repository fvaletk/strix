      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git remote *)",
      "Bash(git symbolic-ref *)",
      "Bash(git merge-base *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh repo view *)",
      "Bash(gh auth status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose run *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose build *)",
      "Bash(docker compose config *)",
      "Bash(docker compose stop *)",
      "Bash(bundle *)",
      "Bash(bin/rails *)",
      "Bash(bin/rubocop *)",
      "Bash(bin/brakeman *)",
      "Bash(bin/dev *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(test *)",
      "Bash(mkdir *)",
      "Bash(mktemp)",
      "Bash(mktemp *)",
      "Bash(chmod +x .claude/hooks/*)",
      "mcp__claude_ai_Linear__list_*",
      "mcp__claude_ai_Linear__get_*",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__whoami",
      "mcp__linear-server__list_*",
      "mcp__linear-server__get_*",
      "mcp__linear-server__create_issue",
      "mcp__linear-server__update_issue",
      "mcp__linear-server__create_comment",
      "mcp__linear__list_*",
      "mcp__linear__get_*",
      "mcp__linear__save_issue",
      "mcp__linear__save_comment",
      "mcp__linear__create_issue",
      "mcp__linear__update_issue",
      "mcp__linear__create_comment"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(config/master.key)",
      "Read(config/credentials/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(config/master.key)",
      "Edit(config/credentials/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo delete *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Bash(docker compose exec * bin/rails db:drop *)",
      "Bash(docker compose exec * bin/rails db:reset *)",
      "Bash(docker compose exec * bin/rails db:purge *)",
      "Bash(bin/rails db:drop *)",
      "Bash(bin/rails db:reset *)",
      "Bash(bin/rails db:purge *)",
      "Bash(bin/rails db:schema:load *)",
      "Bash(bundle exec rails db:drop *)",
      "Bash(bundle exec rails db:reset *)",
      "Bash(bundle exec rails db:purge *)",
      "Bash(bundle exec rails db:schema:load *)",
      "Bash(docker compose exec * bin/rails db:schema:load *)",
      "Bash(docker compose run * bin/rails db:drop *)",
      "Bash(docker compose run * bin/rails db:reset *)",
      "Bash(docker compose run * bin/rails db:purge *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(bin/rails credentials:show *)",
      "Bash(bin/rails credentials:edit *)",
      "mcp__claude_ai_Linear__delete_*",
      "mcp__linear-server__delete_*",
      "mcp__linear__delete_*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/block-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
